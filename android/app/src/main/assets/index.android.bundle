__d((function(e,a,o,i,s,t,n){s.exports={"Please describe the problem.":"请描述问题。","If there are other details you would like to share, please write them here.":"若有其他您愿意分享的细节，请在这里写出。","App version":"应用版本","Server version":"服务器版本",Active:"在线",Idle:"空闲",Offline:"离线",Unavailable:"不可用","Quote and reply":"引用并回复","{username} [said]({link_to_message}):":"{username}[发言道]({link_to_message})：","[Quoting…]":"[引用…]","[Quoting ({serialNumber})…]":"[引用({serialNumber})...]","Quote-and-reply failed":"引用并回复失败",all:"所有",everyone:"每个人",stream:"频道",channel:"频道",topic:"话题","Notify stream":"通知频道","Notify channel":"通知频道","Notify topic":"通知话题","Notify recipients":"提醒收件人","Notify everyone":"提醒每个人","Cannot open image":"无法打开图片","Invalid image URL.":"无效图片地址。","Cannot open link":"无法打开链接","Invalid URL.":"无效网址。","That message could not be found.":"找不到该消息。","That conversation could not be found.":"找不到该对话。","Those messages could not be found.":"找不到这些消息。","Invisible mode":"隐身模式","{num_of_people, plural,\n  one {This message has been <z-link>read</z-link> by {num_of_people} person:}\n  other {This message has been <z-link>read</z-link> by {num_of_people} people:}}":"{num_of_people, plural,\n  other {此消息已被{num_of_people}人<z-link>阅读</z-link>：}}","View read receipts":"查看阅读回执","Failed to show read receipts":"无法显示阅读回执","Read receipts":"阅读回执","Read receipts are not available for Notification Bot messages.":"提醒机器人发送的消息不支持阅读回执功能。","Could not load data.":"无法加载数据。","Still working…":"工作中...","Updates may be delayed.":"更新将推迟。","No one has read this message yet.":"尚无人阅读此消息。",Confirm:"确认","Failed to attach your file.":"无法添加附件。","Failed to attach your files.":"无法添加附件。","Failed to attach some of your files.":"无法添加部分附件。","Configure permissions":"配置权限",You:"你","Discard changes":"放弃更改","You have unsaved changes. Leave without saving?":"您有未保存的更改。不保存就离开？","Who can access the stream?":"谁可以访问此频道？","Who can access the channel?":"谁可以访问此频道?","Cannot apply requested settings":"无法应用请求的设置","Insufficient permission":"权限不足","Web-public":"网络公开","Organization members can join (guests must be invited by a subscriber); anyone on the Internet can view complete message history without creating an account":"组织成员可以加入（访客必须由订阅者邀请）；互联网上的任何人都可以在不创建账号的情况下查看完整的消息历史记录","Only organization administrators and owners can edit streams.":"只有组织管理员和拥有者才能编辑频道","Only organization administrators and owners can edit channels.":"只有组织管理员和拥有者可以编辑频道。","{realmName} only allows organization administrators or owners to make public streams.":"{realmName} 仅允许组织管理员或所有者创建公开频道。","{realmName} only allows organization administrators or owners to make public channels.":"{realmName} 仅允许组织管理员和拥有者创建公开频道。","{realmName} only allows organization moderators, administrators, or owners to make public streams.":"{realmName} 仅允许组织版主、管理员或所有者创建公开频道。","{realmName} only allows organization moderators, administrators, or owners to make public channels.":"{realmName} 仅允许组织版主，管理员，或拥有者才可以创建公开频道。","{realmName} only allows full organization members, moderators, administrators, or owners to make public streams.":"{realmName} 仅允许组织正式成员、版主、管理员或所有者创建公开频道。","{realmName} only allows full organization members, moderators, administrators, or owners to make public channels.":"{realmName} 仅允许组织正式成员、版主、管理员或所有者创建公开频道。","{realmName} only allows organization members, moderators, administrators, or owners to make public streams.":"{realmName} 仅允许组织成员、版主、管理员或所有者创建公开频道。","{realmName} only allows organization members, moderators, administrators, or owners to make public channels.":"{realmName} 仅允许组织成员、版主、管理员或所有者创建公开频道。","{realmName} only allows organization administrators or owners to make private streams.":"{realmName} 仅允许组织管理员或所有者创建私人频道。","{realmName} only allows organization administrators or owners to make private channels.":"{realmName} 仅允许组织管理员或拥有者创建私人频道。","{realmName} only allows organization moderators, administrators, or owners to make private streams.":"{realmName} 仅允许组织版主、管理员或所有者创建私人频道。","{realmName} only allows organization moderators, administrators, or owners to make private channels.":"{realmName} 仅允许组织版主，管理员或拥有者才可创建私人频道。","{realmName} only allows full organization members, moderators, administrators, or owners to make private streams.":"{realmName} 仅允许组织正式成员、版主、管理员或所有者创建私人频道。","{realmName} only allows full organization members, moderators, administrators, or owners to make private channels.":"{realmName} 仅允许组织正式成员、版主、管理员或拥有者创建私人频道。","{realmName} only allows organization members, moderators, administrators, or owners to make private streams.":"{realmName} 仅允许组织成员、版主、管理员或所有者创建私人频道。","{realmName} only allows organization members, moderators, administrators, or owners to make private channels.":"{realmName} 仅允许组织成员、版主、管理员或拥有者创建私人频道。","{realmName} does not allow anybody to make web-public streams.":"{realmName} 不允许任何人创建网络公共频道。","{realmName} does not allow anybody to make web-public channels.":"{realmName} 不允许任何人创建网络公共频道。","{realmName} only allows organization owners to make web-public streams.":"{realmName} 仅允许组织所有者创建网络公共频道。","{realmName} only allows organization owners to make web-public channels.":"{realmName} 仅允许组织所有者创建网络公共频道。","{realmName} only allows organization administrators or owners to make web-public streams.":"{realmName} 仅允许组织管理员或所有者创建网络公开频道。","{realmName} only allows organization administrators or owners to make web-public channels.":"{realmName} 仅允许组织管理员或所有者创建网络公开频道。","{realmName} only allows organization moderators, administrators, or owners to make web-public streams.":"{realmName} 仅允许组织版主、管理员或所有者创建网络公开频道。","{realmName} only allows organization moderators, administrators, or owners to make web-public channels.":"{realmName} 仅允许组织版主、管理员或所有者创建网络公开频道。","Organization members can join (guests must be invited by a subscriber); organization members can view complete message history without joining":"组织成员可以加入（访客必须由订阅者邀请）；组织成员无需加入即可查看完整的消息历史记录","Private, shared history":"私人的、共享的历史消息","Must be invited by a subscriber; new subscribers can view complete message history; hidden from non-administrator users":"必须由订阅者邀请；新订阅者可以查看完整的消息历史记录；对非管理员用户隐藏","Private, protected history":"私人的、受保护的历史消息","Must be invited by a subscriber; new subscribers can only see messages sent after they join; hidden from non-administrator users":"必须由订阅者邀请；新订阅者只能看到他们加入后发送的消息；对非管理员用户隐藏","Cannot subscribe to stream":"无法订阅频道","Cannot subscribe to channel":"无法订阅频道","Stream #{name} is private.":"频道 #{name}  是私有的。","Channel #{name} is private.":"频道 #{name} 是私有的。","See details":"查看详细信息","Failed to show details":"无法显示详细信息","Share canceled":"已取消分享","Zulip terms":"Zulip术语","Terms for {realmName}":"{realmName} 的条款",Dismiss:"忽略","Push notifications are not enabled for {realmName}.":"{realmName} 的推送通知已关闭。","{realmName} is scheduled to switch to a <z-link>plan</z-link> that does not include mobile notifications on {endTimestamp, date, short} at {endTimestamp, time, ::H:mm z}.":"{realmName} 将于 {endTimestamp, date, short} {endTimestamp, time, ::H:mm z} 切换到不包含手机通知的 <z-link>plan</z-link>。","{realmName} is scheduled to switch to a <z-link>plan</z-link> that does not include mobile notifications on {endTimestamp, date, short} at {endTimestamp, time, ::h:mm z}.":"{realmName} 将于 {endTimestamp, date, short} {endTimestamp, time, ::h:mm z} 切换至不包含手机通知的 <z-link>plan</z-link>。","{realmName} is scheduled to switch to a plan that does not include mobile notifications on {endTimestamp, date, short} at {endTimestamp, time, ::H:mm z}.":"{realmName} 将在 {endTimestamp, date, short} {endTimestamp, time, ::H:mm z} 切换至不包含手机通知的计划。","{realmName} is scheduled to switch to a plan that does not include mobile notifications on {endTimestamp, date, short} at {endTimestamp, time, ::h:mm z}.":"{realmName} 将在 {endTimestamp, date, short} {endTimestamp, time, ::h:mm z} 切换至不包含手机通知的计划。","The Zulip server at {realm} has not yet registered your device token. A request is in progress.":"{realm}上的Zulip服务器尚未针对你的设备令牌注册。正在提出请求。","The Zulip server at {realm} has not yet registered your device token.":"{realm}上的Zulip服务器尚未针对你的设备令牌注册。","Registration failed":"注册失败",Retry:"重试","Message not saved":"消息未保存","Save message":"保存消息","Send message":"发送消息","Please wait for the upload to complete.":"请等待上传完成。","To upload an image, please grant Zulip additional permissions in Settings.":"要上传图片，请在设置中授予 Zulip 额外权限。","Permissions needed":"需要权限","Open settings":"打开设置","Camera unavailable.":"相机不可用。",Error:"错误","The server sent a malformed response.":"服务器发送了格式错误的响应。","Storage permission needed":"需要存储权限","Zulip will save a copy of your photo on your device. To do so, Zulip will need permission to store files on your device.":"Zulip 会将您的照片副本保存在您的设备上。为此，Zulip 需要获得在您的设备上存储文件的权限。","Message not sent":"消息未发送","Please specify a topic.":"请指定一个话题。","Please specify a stream.":"请指定一个频道。","Please specify a channel.":"请指定一个频道。","Please specify a valid stream.":"请指定一个有效的频道。","Please specify a valid channel.":"请指定一个有效的频道。","Please choose recipients.":"请选择回复对象。","Message is empty.":"消息为空。","Could not connect":"无法连接","The server at {realm} said:\n\n{message}":"来自{realm}服务器的消息：\n\n{message}","Could not connect to {realm}. Please check your network connection and try again.":"无法连接到 {realm}。请检查网络连接后重试。","Server not supported":"服务器不支持","{realm} is running Zulip Server {version}, which is unsupported. The minimum supported version is Zulip Server {minSupportedVersion}.":" {realm}正在运行不受支持的Zulip服务器{version}。最早受支持Zulip服务器版本为{minSupportedVersion}。","The server at {realm} does not seem to be a Zulip server.":"{realm}处似乎没有Zulip服务器。","Find your Zulip server URL":"查找你的Zulip服务器网址","The server at {realm} encountered an error.":"{realm}处的服务器发生了错误。","Failed to connect to server: {realm}":"无法连接到服务器：{realm}","{_}":"{_}",Home:"主页","Combined feed":"综合信息","Direct messages":"Direct messages",Starred:"星标消息",Mentions:"被提及消息",Message:"信息",Send:"发送","No recent conversations":"没有最近的对话","No results":"没有结果","No messages":"没有消息","No messages on server":"服务器上没有消息","No messages in stream":"频道里没有消息","No messages in channel":"频道里没有消息","No messages with this topic":"该话题没有消息","No messages with this person":"该用户没有消息","No messages in this group":"该组没有消息","No unread messages":"没有未读消息","Pick account":"选择账号",Welcome:"欢迎","Enter your Zulip server URL: <z-link>(What’s this?)</z-link>":"输入您的Zulip服务器网址：<z-link>（这是什么？）</z-link>","Suggestion: <z-link>{suggestedServerUrl}</z-link>":"建议：<z-link>{suggestedServerUrl}</z-link>",Search:"搜索","Log in":"登录",Enter:"进入","Switch account":"切换账号","Log out":"退出","This will log out {email} on {realmUrl} from the mobile app on this device.":"这将从该设备上的移动应用程序中注销 {realmUrl} 上的 {email}。","Add new account":"新增账号","All streams":"所有频道","All channels":"所有频道",Email:"电子邮箱",Username:"用户名",Password:"密码","Why not start the conversation?":"何不开始对话？","That conversation doesn’t seem to exist.":"该对话似乎不存在。","Request timed out.":"请求超时。","Sign in with {method}":"使用 {method} 登录","Invalid input":"无效输入","Please enter a URL.":"请输入网址。","Please enter a valid URL.":"请输入有效网址。","Please enter the server URL, not your email.":"请输入服务器网址，而不是您的电子邮箱地址。","The server URL must start with http:// or https://.":"服务器网址必须以 http:// 或 https:// 开头。","Wrong email or password. Try again.":"电子邮箱或密码错误，请重试。","Wrong username or password. Try again.":"用户名或密码错误，请重试。","Enter a valid email address":"请输入有效的电子邮箱地址","Enter a username":"输入用户名","Enter a password":"请输入密码",Reply:"回复","Add a reaction":"添加表情符号","Copy to clipboard":"复制到剪贴板",Copied:"已复制","Copy invalid link":"复制无效链接","This link appears to be invalid. Do you want to copy it anyway?\n\n{text}":"这个链接显然是无效的。你想继续复制吗？\n\n{text}","Text copied":"文字已复制","Link copied":"链接已复制","This time is in your timezone. Original text was “{originalText}”.":"这是您所在时区的时间。原是“{originalText}”。","Mute topic":"静音话题","Resolve topic":"解决话题","Failed to resolve topic":"无法解决话题","Unresolve topic":"将话题记为未解决","Failed to unresolve topic":"无法将话题记为未解决","No messages in topic: {streamAndTopic}":"话题中没有消息：{streamAndTopic}","Delete topic":"删除话题","Deleting a topic will immediately remove it and its messages for everyone. Other users may find this confusing, especially if they had received an email or push notification related to the deleted messages.\n\nAre you sure you want to permanently delete “{topic}”?":"删除话题将立即删除它及其对所有人的消息。其他用户可能会感到困惑，尤其是当他们收到与已删除消息相关的电子邮箱或推送通知时。\n\n你确认要删除“{topic}”吗？","Unmute topic":"非静音话题","Follow topic":"关注话题","Failed to follow topic":"无法关注话题","Unfollow topic":"取关话题","Failed to unfollow topic":"无法取关话题","Mute stream":"静音频道","Mute channel":"静音频道","Unmute stream":"解除静音频道","Unmute channel":"解除静音频道","No Internet connection":"无互联网连接","Please check your Internet connection":"请检查您的互联网连接","Zulip’s Internet connection is uncertain.":"无法确定Zulip的联网情况。","Zulip is offline.":"Zulip已离线。","Zulip is online.":"Zulip已连接。","{realm} is running Zulip Server {serverVersion}, which is unsupported. Please upgrade your server as soon as possible.":"{realm} 正在运行不受支持的 Zulip 服务器 {serverVersion}。请尽快升级您的服务器。","{realm} is running Zulip Server {serverVersion}, which is unsupported. Please contact your administrator about upgrading.":"{realm} 正在运行不受支持的 Zulip 服务器 {serverVersion}。请联系您的管理员进行升级。","Learn more":"了解更多","Full profile":"全部资料",Settings:"设置","Night mode":"暗色模式","Open links with in-app browser":"使用应用内浏览器打开链接",Language:"语言",Arabic:"阿拉伯语","Luri (Bakhtiari)":"卢尔语（巴赫蒂亚里语）",Belarusian:"白俄罗斯语",Bulgarian:"保加利亚语",Catalan:"加泰罗尼亚语","Chinese (China)":"中文（中国）","Chinese (Taiwan)":"中文（台湾）",Czech:"捷克语",Danish:"丹麦语",Dutch:"荷兰语",English:"英语","English (U.K.)":"英语（英国）",Finnish:"芬兰",French:"法语",Galician:"加利西亚语",German:"德语",Greek:"希腊语",Gujarati:"古吉拉特语",Hindi:"北印度语",Hungarian:"匈牙利语",Indonesian:"印度尼西亚语",Italian:"意大利语",Japanese:"日语",Korean:"韩语",Latvian:"拉脱维亚语",Lithuanian:"立陶宛语",Malayalam:"马拉雅拉姆语",Mongolian:"蒙古语",Persian:"波斯语",Polish:"波兰语",Portuguese:"葡萄牙语","Portuguese (Portugal)":"葡萄牙语（葡萄牙）",Romanian:"罗马尼亚语",Russian:"俄语",Serbian:"塞尔维亚语",Sinhala:"僧伽罗语",Slovenian:"Slovenian",Spanish:"西班牙语",Swedish:"瑞典",Tagalog:"他加禄语",Tamil:"泰米尔语",Turkish:"土耳其语",Ukrainian:"乌克兰",Vietnamese:"越南语",Welsh:"威尔士语",Topic:"话题","Type a message":"输入消息","Message group":"消息群组",starred:"星标消息","Enable notifications":