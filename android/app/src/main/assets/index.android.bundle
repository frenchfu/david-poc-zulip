__d((function(e,a,o,i,s,t,n){s.exports={"Please describe the problem.":"Калі ласка, апішыце праблему.","If there are other details you would like to share, please write them here.":"Калі ёсць іншыя падрабязнасці, якімі б вы хацелі б падзяліцца, калі ласка, запішыце іх тут.","App version":"Версія праграмы","Server version":"Версія сервера",Active:"У сетцы",Idle:"Адыйшоў",Offline:"Па-за сеткай",Unavailable:"Недасяжны","Quote and reply":"Адказаць з цытатай","{username} [said]({link_to_message}):":"{імякарыстальніка} [сказаў]({спасылка_на_паведамленне}):","[Quoting…]":"[Цытаванне…]","[Quoting ({serialNumber})…]":"[Цытаванне ({серыйныНумар})…]","Quote-and-reply failed":"Адказаць з цытатай не атрымалася",all:"усё",everyone:"усе",stream:"плынь",channel:"Канал",topic:"тэма","Notify stream":"Паведамленні Плынь","Notify channel":"Апавяшчэнні каналаў","Notify topic":"Паведамленні тэма","Notify recipients":"Паведамленні Атрымальнікі","Notify everyone":"Паведамленні Усе","Cannot open image":"Немагчыма адкрыць відарыс","Invalid image URL.":"Няправільны URL відарыса","Cannot open link":"Немагчама адкрыть спасылку","Invalid URL.":"Няправільны URL.","That message could not be found.":"Гэта паведамленне не знойдзена","That conversation could not be found.":"Гэта размова не знойдзена","Those messages could not be found.":"Паведамленне не знойдзена","Invisible mode":"Рэжым нябачнасці","{num_of_people, plural,\n  one {This message has been <z-link>read</z-link> by {num_of_people} person:}\n  other {This message has been <z-link>read</z-link> by {num_of_people} people:}}":"{num_of_people, plural,\n  one {Гэта паведамленне <z-link>прачытал</z-link> {num_of_people} чалавек} few {Гэта паведамленне <z-link>прачыталі</z-link> {num_of_people} людзей} many {Гэта паведамленне <z-link>прачыталі</z-link> {num_of_people} людзей} other {Гэта паведамленне <z-link>прачыталі</z-link> {num_of_people} людзей}}","View read receipts":"Праглядзець хто прачытаў","Failed to show read receipts":"Не ўдалося паказаць спіс прачытаўшых","Read receipts":"Спіс прачытаўшых","Read receipts are not available for Notification Bot messages.":"Спіс прачытаўшых недаступны для паведамленняў Notification Bot.","Could not load data.":"Не атрымалася загрузіць даныя","Still working…":"Працуе…","Updates may be delayed.":"Абнаўленні могуць быць адкладзены.","No one has read this message yet.":"Гэта паведамленне яшчэ ніхто не чытаў.",Confirm:"Пацвердзіць","Failed to attach your file.":"Не атрымалася далучыць файл.","Failed to attach your files.":"Не атрымалася далучыць файлы.","Failed to attach some of your files.":"Не атрымалася далучыць некаторыя файлы.","Configure permissions":"Наладзьце дазволы",You:"Вы","Discard changes":"Скасаваць змены","You have unsaved changes. Leave without saving?":"У вас ёсць незахаваныя змены. Пакінуць без захавання?","Who can access the stream?":"Хто можа атрымаць доступ да плыні?","Who can access the channel?":"Хто мае доступ да канала?","Cannot apply requested settings":"Немагчыма прымяніць запытаныя налады","Insufficient permission":"Недастатковы дазвол","Web-public":"вэб-паблік","Organization members can join (guests must be invited by a subscriber); anyone on the Internet can view complete message history without creating an account":"Члены арганізацыі могуць далучыцца (госці павінны быць запрошаны удзельнікам); любы чалавек у інтэрнэце можа праглядаць поўную гісторыю паведамленняў без стварэння ўліковага запісу","Only organization administrators and owners can edit streams.":"Рэдагаваць плыні могуць толькі адміністратары і ўладальнікі арганізацыі.","Only organization administrators and owners can edit channels.":"Толькі адміністратар арганізацыі і ўладар могуць рэдагаваць каналы.","{realmName} only allows organization administrators or owners to make public streams.":"{realmName} дазваляе толькі адміністратарам або ўладальнікам арганізацыі ствараць агульнадаступныя плыні.","{realmName} only allows organization administrators or owners to make public channels.":"{realmName} дазваляе толькі адміністратарам арганізацый і ўладальнікам рабіць агульнадаступныя каналы.","{realmName} only allows organization moderators, administrators, or owners to make public streams.":"{realmName} дазваляе толькі мадэратарам, адміністратарам або ўладальнікам арганізацыі ствараць агульнадаступныя плыні.","{realmName} only allows organization moderators, administrators, or owners to make public channels.":"{realmName} дазваляе толькі мадэратарам, адміністратарам або ўладальнікам арганізацыі ствараць агульнадаступныя каналы.","{realmName} only allows full organization members, moderators, administrators, or owners to make public streams.":"{realmName} дазваляе толькі паўнапраўным членам арганізацыі, мадэратарам, адміністратарам або ўладальнікам ствараць агульнадаступныя плыні.","{realmName} only allows full organization members, moderators, administrators, or owners to make public channels.":"{realmName} дазваляе толькі членам арганізацыі, мадэратарам, адміністратарам або ўладальнікам ствараць прыватныя каналы.","{realmName} only allows organization members, moderators, administrators, or owners to make public streams.":"{realmName} дазваляе толькі членам арганізацыі, мадэратарам, адміністратарам або ўладальнікам ствараць агульнадаступныя плыні.","{realmName} only allows organization members, moderators, administrators, or owners to make public channels.":"{realmName} дазваляе толькі членам арганізацыі, мадэратарам, адміністратарам або ўладальнікам ствараць прыватныя каналы.","{realmName} only allows organization administrators or owners to make private streams.":"{realmName} дазваляе толькі адміністратарам і ўладальнікам арганізацыі ствараць прыватныя плыні.","{realmName} only allows organization administrators or owners to make private channels.":"{realmName} дазваляе толькі адміністратарам арганізацый і ўладальнікам рабіць агульнадаступныя каналы.","{realmName} only allows organization moderators, administrators, or owners to make private