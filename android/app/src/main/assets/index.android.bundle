__d((function(e,a,o,n,i,t,s){i.exports={"Please describe the problem.":"Молим вас опишите проблем.","If there are other details you would like to share, please write them here.":"Ако постоје други детаљи које желите да поделите, напишите их овде.","App version":"Верзија апликације","Server version":"Верзија сервера",Active:"Активни",Idle:"Мирује",Offline:"Ван мреже",Unavailable:"Недоступан","Quote and reply":"Цитирај и одговори","{username} [said]({link_to_message}):":"{username} [је рекао]({link_to_message}):","[Quoting…]":"[Цитирање…]","[Quoting ({serialNumber})…]":"[Цитирање ({serialNumber})…]","Quote-and-reply failed":"Цитирај-и-одговори није успело",all:"сви",everyone:"свако",stream:"ток",channel:"channel",topic:"тема","Notify stream":"Обавести ток","Notify channel":"Notify channel","Notify topic":"Тема за обавештење","Notify recipients":"Обавести примаоце","Notify everyone":"Обавести све","Cannot open image":"Није могуће отворити слику","Invalid image URL.":"Неисправна адреса слике.","Cannot open link":"Не могу да отворим везу","Invalid URL.":"Неисправна адреса","That message could not be found.":"Та порука није могла бити пронађена.","That conversation could not be found.":"Тај разговор није могао бити пронађен.","Those messages could not be found.":"Те поруке нису могле бити пронађене.","Invisible mode":"Невидљивост","{num_of_people, plural,\n  one {This message has been <z-link>read</z-link> by {num_of_people} person:}\n  other {This message has been <z-link>read</z-link> by {num_of_people} people:}}":"{num_of_people, plural,\n  one {Ову поруку је <z-link>прочитала</z-link> {num_of_people} особа:} few {Ову поруку је <z-link>прочитало</z-link> {num_of_people} људи:} other {Ову поруку је <z-link>прочитало</z-link>  {num_of_people} људи:}}","View read receipts":"Прикажи потврде читања","Failed to show read receipts":"Неуспело приказивање потврда читања","Read receipts":"Потврде читања","Read receipts are not available for Notification Bot messages.":"Потврде читања нису доступне за поруке од Бота обавештења.","Could not load data.":"Није успело учитавање података.","Still working…":"И даље се извршава...","Updates may be delayed.":"Исправке су можда одложене.","No one has read this message yet.":"Још нико није прочитао ову поруку.",Confirm:"Потврди","Failed to attach your file.":"Прилагање датотеке није успело.","Failed to attach your files.":"Прилагање датотека није успело.","Failed to attach some of your files.":"Прилагање неких датотека није успело.","Configure permissions":"Подесите дозволе",You:"Ви","Discard changes":"Одбаци измене","You have unsaved changes. Leave without saving?":"Имате несачуване измене. Изаћи без чувања?","Who can access the stream?":"Ко може да приступи овом току?","Who can access the channel?":"Who can access the channel?","Cannot apply requested settings":"Није могуће применити захтевана подешавања","Insufficient permission":"Недовољна дозвола","Web-public":"Јавно доступно","Organization members can join (guests must be invited by a subscriber); anyone on the Internet can view complete message history without creating an account":"Чланови организације могу да приступе (гости морају да буду позвани од стране члана); свако на интернету може видети комплетну историју порука без креирања налога","Only organization administrators and owners can edit streams.":"Само администратори и власници организације могу да уређују токове.","Only organization administrators and owners can edit channels.":"Only organization administrators and owners can edit channels.","{realmName} only allows organization administrators or owners to make public streams.":"{realmName} дозвољава само администраторима или власницима организације да праве јавне токове.","{realmName} only allows organization administrators or owners to make public channels.":"{realmName} only allows organization administrators or owners to make public channels.","{realmName} only allows organization moderators, administrators, or owners to make public streams.":"{realmName} дозвољава само модераторима, администраторима или власницима организације да праве јавне токове.","{realmName} only allows organization moderators, administrators, or owners to make public channels.":"{realmName} only allows organization moderators, administrators, or owners to make public channels.","{realmName} only allows full organization members, moderators, administrators, or owners to make public streams.":"{realmName} дозвољава само пуним члановима, модераторима, администраторима или власницима организације да праве јавне токове.","{realmName} only allows full organization members, moderators, administrators, or owners to make public channels.":"{realmName} only allows full organization members, moderators, administrators, or owners to make public channels.","{realmName} only allows organization members, moderators, administrators, or owners to make public streams.":"{realmName} дозвољава само члановима, модераторима, администраторима или власницима организације да праве јавне токове.","{realmName} only allows organization members, moderators, administrators, or owners to make public channels.":"{realmName} only allows organization members, moderators, administrators, or owners to make public channels.","{realmName} only allows organization administrators or owners to make private streams.":"{realmName} дозвољава само администраторима или власницима организације да праве приватне токове.","{realmName} only allows organization administrators or owners to make private channels.":"{realmName} only allows organization administrators or owners to make private channels.","{realmName} only allows organization moderators, administrators, or owners to make private streams.":"{realmName} дозвољава само модераторима, администраторима или власницима организације да праве приватне токове.","{realmName} only allows organization moderators, administrators, or owners to make private channels.":"{realmName} only allows organization moderators, administrators, or owners to make private channels.","{realmName} only allows full organization members, moderators, administrators, or owners to make private streams.":"{realmName} дозвољава само пуним члановима, модераторима, администраторима или власницима организације да праве приватне токове.","{realmName} only allows full organization members, moderators, administrators, or owners to make private channels.":"{realmName} only allows full organization members, moderators, administrators, or owners to make private channels.","{realmName} only allows organization members, moderators, administrators, or owners to make private streams.":"{realmName} дозвољава само члановима, модераторима, администраторима или власницима организације да праве приватне токове.","{realmName} only allows organization members, moderators, administrators, or owners to make private channels.":"{realmName} only allows organization members, moderators, administrators, or owners to make private channels.","{realmName} does not allow anybody to make web-public streams.":"{realmName} не дозвољава никоме да креира токове доступне на вебу.","{realmName} does not allow anybody to make web-public channels.":"{realmName} does not allow anybody to make web-public channels.","{realmName} only allows organization owners to make web-public streams.":"{realmName} дозвољава само власницима организације да праве токове доступне на вебу.","{realmName} only allows organization owners to make web-public channels.":"{realmName} only allows organization owners to make web-public channels.","{realmName} only allows organization administrators or owners to make web-public streams.":"{realmName} дозвољава само администраторима или власницима организације да праве токове доступне на вебу.","{realmName} only allows organization administrators or owners to make web-public channels.":"{realmName} only allows organization administrators or owners to make web-public channels.","{realmName} only allows organization moderators, administrators, or owners to make web-public streams.":"{realmName} дозвољава само модераторима, администраторима или власницима организације да праве токове доступне на вебу.","{realmName} only allows organization moderators, administrators, or owners to make web-public channels.":"{realmName} only allows organization moderators, administrators, or owners to make web-public channels.","Organization members can join (guests must be invited by a subscriber); organization members can view complete message history without joining":"Чланови организације могу да приступе (гости морају да буду позвани од стране члана); чланови организације могу да виде комплетну историју порука без приступања","Private, shared history":"Приватно, дељена историја","Must be invited by a subscriber; new subscribers can view complete message history; hidden from non-administrator users":"Морају бити позвани од стране члана; нови чланови могу да виде комплетну историју порука; сакривен од стране корисника који нису администратори.","Private, protected history":"Приватно, заштићена историја","Must be invited by a subscriber; new subscribers can only see messages sent after they join; hidden from non-administrator users":"Морају бити позвани од стране члана; нови чланови могу да виде само поруке од времена учлањења; сакривен од стране корисника који нису администратори.","Cannot subscribe to stream":"Није могуће учланити се у ток","Cannot subscribe to channel":"Cannot subscribe to channel","Stream #{name} is private.":"Ток #{name} је приватан.","Channel #{name} is private.":"Channel #{name} is private.","See details":"Види детаље","Failed to show details":"Неуспело приказивање детаља","Share canceled":"Дељење поништено","Zulip terms":"Зулип услови","Terms for {realmName}":"Услови за {realmName}",Dismiss:"Dismiss","Push notifications are not enabled for {realmName}.":"Push notifications are not enabled for {realmName}.","{realmName} is scheduled to switch to a <z-link>plan</z-link> that does not include mobile notifications on {endTimestamp, date, short} at {endTimestamp, time, ::H:mm z}.":"{realmName} is scheduled to switch to a <z-link>plan</z-link> that does not include mobile notifications on {endTimestamp, date, short} at {endTimestamp, time, ::H:mm z}.","{realmName} is scheduled to switch to a <z-link>plan</z-link> that does not include mobile notifications on {endTimestamp, date, short} at {endTimestamp, time, ::h:mm z}.":"{realmName} is scheduled to switch to a <z-link>plan</z-link> that does not include mobile notifications on {endTimestamp, date, short} at {endTimestamp, time, ::h:mm z}.","{realmName} is scheduled to switch to a plan that does not include mobile notifications on {endTimestamp, date, short} at {endTimestamp, time, ::H:mm z}.":"{realmName} is scheduled to switch to a plan that does not include mobile notifications on {endTimestamp, date, short} at {endTimestamp, time, ::H:mm z}.","{realmName} is scheduled to switch to a plan that does not include mobile notifications on {endTimestamp, date, short} at {endTimestamp, time, ::h:mm z}.":"{realmName} is scheduled to switch to a plan that does not include mobile notifications on {endTimestamp, date, short} at {endTimestamp, time, ::h:mm z}.","The Zulip server at {realm} has not yet registered your device token. A request is in progress.":"Зулип сервер у {realm} још увек није регистровао токен вашег уређаја. Захтев је у току.","The Zulip server at {realm} has not yet registered your device token.":"Зулип сервер у {realm} још увек није регистровао токен вашег уређаја.","Registration failed":"Регистрација није успела",Retry:"Покушај поново","Message not saved":"Порука није сачувана","Save message":"Сачувај поруку","Send message":"Пошаљи поруку","Please wait for the upload to complete.":"Молим вас сачекајте да се постављање заврши.","To upload an image, please grant Zulip additional permissions in Settings.":"Да би сте поставили слику, молим вас омогућите Зулипу додатне дозволе у подешавањима.","Permissions needed":"Потребне су дозволе","Open settings":"Отворите подешавања","Camera unavailable.":"Камера није доступна.",Error:"Грешка","The server sent a malformed response.":"Сервер је послао лоше форматиран одговор.","Storage permission needed":"Потребне су дозволе за складиште","Zulip will save a copy of your photo on your device. To do so, Zulip will need permission to store files on your device.":"Зулип ће сачувати копију ваше слике на уређају. Да би то урадио, Зулипу је потребна дозвола да чува датотеке на вашем уређају.","Message not sent":"Порука није послата","Please specify a topic.":"Молим вас наведите тему.","Please specify a stream.":"Молим вас наведите ток.","Please specify a channel.":"Please specify a channel.","Please specify a valid stream.":"Молим вас наведите исправан ток.","Please specify a valid channel.":"Please specify a valid channel.","Please choose recipients.":"Молим вас наведите примаоце.","Message is empty.":"Порука је празна.","Could not connect":"Неуспело повезивање","The server at {realm} said:\n\n{message}":"Сервер у {realm} је одговорио:\n\n{message}","Could not connect to {realm}. Please check your network connection and try again.":"Неуспело повезивање у {realm}. Молим вас проверите вашу мрежну везу и покушајте поново.","Server not supported":"Сервер није подржан","{realm} is running Zulip Server {version}, which is unsupported. The minimum supported version is Zulip Server {minSupportedVersion}.":"{realm} се покреће на Зулип серверу {version}, која није подржана. Минимална верзија која је подржана је Зулип сервер {minSupportedVersion}.","The server at {realm} does not seem to be a Zulip server.":"Сервер у {realm} изгледа да није Зулип сервер.","Find your Zulip server URL":"Пронађите адресу вашег Зулип сервера","The server at {realm} encountered an error.":"Сервер у {realm} је наишао на грешку.","Failed to connect to server: {realm}":"Неуспело повезивање на сервер: {realm}","{_}":"{_}",Home:"Почетна","Combined feed":"Combined feed","Direct messages":"Директне поруке",Starred:"Са звездицом",Mentions:"Помињања",Message:"Порука",Send:"Пошаљи","No recent conversations":"Нема недавних разговора","No results":"Нема резултата","No messages":"Нема порука","No messages on server":"Нема порука на серверу","No messages in stream":"Нема порука у току","No messages in channel":"No messages in channel","No messages with this topic":"Нема порука са овом темом","No messages with this person":"Нема порука са овом особом","No messages in this group":"Нема порука у овој групи","No unread messages":"Нема непрочитаних порука","Pick account":"Изаберите налог",Welcome:"Добродошли","Enter your Zulip server URL: <z-link>(What’s this?)</z-link>":"Унесите адресу вашег Зулип сервера: <z-link>(Шта је ово?)</z-link>","Suggestion: <z-link>{suggestedServerUrl}</z-link>":"Предлог: <z-link>{suggestedServerUrl}</z-link>",Search:"Претрага","Log in":"Пријави се",Enter:"Уђи","Switch account":"Промени налог","Log out":"Одјави ме","This will log out {email} on {realmUrl} from the mobile app on this device.":"Ово ће одјавити {email} из {realmUrl} у апликацији на овом уређају.","Add new account":"Додај нови налог","All streams":"Сви токови","All channels":"All channels",Email:"Е-пошта",Username:"Корисничко име",Password:"Лозинка","Why not start the conversation?":"Зашто не бисте започели разговор?","That conversation doesn’t seem to exist.":"Тај разговор изгледа да не постоји.","Request timed out.":"Захтев је истекао.","Sign in with {method}":"Пријавите се са {method}","Invalid input":"Неисправан унос","Please enter a URL.":"Молим вас унесите адресу.","Please enter a valid URL.":"Молим вас унесите исправну адресу.","Please enter the server URL, not your email.":"Молим вас унесите адресу сервера, не адресу ваше е-поште.","The server URL must start with http:// or https://.":"Адреса сервера мора почети са http:// или https://.","Wrong email or password. Try again.":"Погрешна е-пошта или лозинка. Покушајте поново.","Wrong username or password. Try again.":"Погрешно корисничко име или лозинка. Покушајте поново.","Enter a valid email address":"Упишите исправну адресу е-поште","Enter a username":"Упишите корисничко име","Enter a password":"Упишите лозинку",Reply:"Одговори","Add a reaction":"Додај реакцију","Copy to clipboard":"Копирај на бележницу",Copied:"Ископирано!","Copy invalid link":"Copy invalid link","This link appears to be invalid. Do you want to copy it anyway?\n\n{text}":"This link appears to be invalid. Do you want to copy it anyway?\n\n{text}","Text copied":"Text copied","Link copied":"Веза је копирана","This time is in your timezone. Original text was “{originalText}”.":"Ово време је у вашој временској зони. Оригинални текст је био “{originalText}”.","Mute topic":"Утишај тему","Resolve topic":"Реши тему","Failed to resolve topic":"Неуспело решавање теме","Unresolve topic":"Поништи решеност теме","Failed to unresolve topic":"Неуспело поништавање решености теме","No messages in topic: {streamAndTopic}":"Нема порука у теми: {streamAndTopic}","Delete topic":"Обриши тему","Deleting a topic will immediately remove it and its messages for everyone. Other users may find this confusing, especially if they had received an email or push notification related to the deleted messages.\n\nAre you sure you want to permanently delete “{topic}”?":"Брисање теме ће је моментално уклонити са све порукама за све чланове. Осталим корисницима ово може бити збуњујуће, нарочито ако су примили е-поруку или обавештење повезано са обрисаним порукама.\n\nДа ли сте сигурни да желите трајно да обришете “{topic}”?","Unmute topic":"Поништи утишање теме","Follow topic":"Прати тему","Failed to follow topic":"Није успело праћење теме","Unfollow topic":"Прекини праћење теме","Failed to unfollow topic":"Није успео прекид праћења теме","Mute stream":"Утишај ток","Mute channel":"Mute channel","Unmute stream":"Поништи утишање тока","Unmute channel":"Unmute channel","No Internet connection":"Нема везе са интернет