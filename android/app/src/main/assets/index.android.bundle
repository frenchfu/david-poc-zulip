__d((function(e,a,o,i,t,n,s){t.exports={"Please describe the problem.":"Please describe the problem.","If there are other details you would like to share, please write them here.":"If there are other details you would like to share, please write them here.","App version":"アプリバージョン","Server version":"サーバーバージョン",Active:"アクティブ",Idle:"退席中",Offline:"オフライン",Unavailable:"無効","Quote and reply":"引用して返信","{username} [said]({link_to_message}):":"{username} [said]({link_to_message}):","[Quoting…]":"[引用中...]","[Quoting ({serialNumber})…]":"[Quoting ({serialNumber})…]","Quote-and-reply failed":"Quote-and-reply failed",all:"すべて",everyone:"全員",stream:"ストリーム",channel:"チャンネル",topic:"topic","Notify stream":"ストリームを通知する","Notify channel":"チャンネル登録者に通知","Notify topic":"トピックの参加者に通知","Notify recipients":"受信者に通知","Notify everyone":"Notify everyone","Cannot open image":"画像を開けません","Invalid image URL.":"画像のURLが無効です","Cannot open link":"Cannot open link","Invalid URL.":"無効なURL","That message could not be found.":"That message could not be found.","That conversation could not be found.":"That conversation could not be found.","Those messages could not be found.":"Those messages could not be found.","Invisible mode":"Invisible mode","{num_of_people, plural,\n  one {This message has been <z-link>read</z-link> by {num_of_people} person:}\n  other {This message has been <z-link>read</z-link> by {num_of_people} people:}}":"{num_of_people, plural,\n  other {{num_of_people} 人がこのメッセージを<z-link>読みました</z-link>：}}","View read receipts":"開封を確認","Failed to show read receipts":"開封を確認に失敗しました","Read receipts":"開封確認","Read receipts are not available for Notification Bot messages.":"開封確認は、Notification Bot のメッセージでは利用できません。","Could not load data.":"データを読み込めませんでした","Still working…":"処理中...","Updates may be delayed.":"更新は遅れる場合があります。","No one has read this message yet.":"このメッセージを読んだユーザーはいません",Confirm:"確認","Failed to attach your file.":"Failed to attach your file.","Failed to attach your files.":"Failed to attach your files.","Failed to attach some of your files.":"Failed to attach some of your files.","Configure permissions":"権限を設定する",You:"あなた","Discard changes":"変更を破棄","You have unsaved changes. Leave without saving?":"保存していない変更があります。保存せずに離れますか？","Who can access the stream?":"ストリームにアクセスできるユーザー","Who can access the channel?":"Who can access the channel?","Cannot apply requested settings":"要求された設定を適用できませんでした","Insufficient permission":"権限が足りません","Web-public":"Web公開","Organization members can join (guests must be invited by a subscriber); anyone on the Internet can view complete message history without creating an account":"組織のメンバーは参加できます（ゲストは他のフォロワーから招待される必要があります）。アカウントを作成することなく、インターネット上の誰でも、全てのメッセージを閲覧できます。","Only organization administrators and owners can edit streams.":"組織の管理者と所有者のみがストリームを編集できます。","Only organization administrators and owners can edit channels.":"Only organization administrators and owners can edit channels.","{realmName} only allows organization administrators or owners to make public streams.":"{realmName} では、組織の管理者または所有者のみが公開ストリームを作成できます。","{realmName} only allows organization administrators or owners to make public channels.":"{realmName} only allows organization administrators or owners to make public channels.","{realmName} only allows organization moderators, administrators, or owners to make public streams.":"{realmName} では、組織のモデレーター、管理者、または所有者のみが公開ストリームを作成できます。","{realmName} only allows organization moderators, administrators, or owners to make public channels.":"{realmName} only allows organization moderators, administrators, or owners to make public channels.","{realmName} only allows full organization members, moderators, administrators, or owners to make public streams.":"{realmName} では、組織の完全なメンバー、モデレーター、管理者、または所有者のみが公開ストリームを作成できます。","{realmName} only allows full organization members, moderators, administrators, or owners to make public channels.":"{realmName} only allows full organization members, moderators, administrators, or owners to make public channels.","{realmName} only allows organization members, moderators, administrators, or owners to make public streams.":"{realmName} では、組織のメンバー、モデレーター、管理者、または所有者のみが公開ストリームを作成できます。","{realmName} only allows organization members, moderators, administrators, or owners to make public channels.":"{realmName} only allows organization members, moderators, administrators, or owners to make public channels.","{realmName} only allows organization administrators or owners to make private streams.":"{realmName} では、組織の管理者または所有者のみが非公開ストリームを作成できます。","{realmName} only allows organization administrators or owners to make private channels.":"{realmName} only allows organization administrators or owners to make private channels.","{realmName} only allows organization moderators, administrators, or owners to make private streams.":"{realmName} では、組織のモデレーター、管理者、または所有者のみが非公開ストリームを作成できます。","{realmName} only allows organization moderators, administrators, or owners to make private channels.":"{realmName} only allows organization moderators, administrators, or owners to make private channels.","{realmName} only allows full organization members, moderators, administrators, or owners to make private streams.":"{realmName} では、組織の完全なメンバー、モデレーター、管理者、または所有者のみが非公開ストリームを作成できます。","{realmName} only allows full organization members, moderators, administrators, or owners to make private channels.":"{realmName} only allows full organization members, moderators, administrators, or owners to make private channels.","{realmName} only allows organization members, moderators, administrators, or owners to make private streams.":"{realmName} では、組織のメンバー、モデレーター、管理者、または所有者のみが非公開ストリームを作成できます。","{realmName} only allows organization members, moderators, administrators, or owners to make private channels.":"{realmName} only allows organization members, moderators, administrators, or owners to make private channels.","{realmName} does not allow anybody to make web-public streams.":"{realmName} では、ウェブ公開ストリームの作成を許可された