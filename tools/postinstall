#!/usr/bin/env bash
set -eu

ROOT_DIR=$(git rev-parse --show-toplevel)

patch_package() {
    node_modules/.bin/patch-package
}

# Since we take react-native from Git, some packages that ship with it
# and are used in the build need their build scripts run.
build_rn_packages() {
    (
        cd node_modules/react-native/packages/react-native-codegen/
        # A copy of the package's `yarn build` script
        # with a `--verbose` flag removed.
        yarn clean && node scripts/build.js
    )
}

pod_install() {
    [[ "$OSTYPE" == "darwin"* ]] \
        || return 0

    if ! hash pod 2>/dev/null; then
        cat >&2 <<EOF
The Zulip mobile app requires CocoaPods for its iOS build. Please
install it, following the instructions at
https://guides.cocoapods.org/using/getting-started.html.

Then, rerun yarn.
EOF
        exit 1
    fi

    pod install --project-directory="$ROOT_DIR/ios"
}

jetify() {
    node_modules/.bin/jetify
}

patch_package

build_rn_packages

# Fix React Native podspecs for modern Ruby, Boost archive, and Xcode 15+ C++
if [ -f "node_modules/react-native/ReactCommon/yoga/yoga/YGValue.h" ]; then
    sed -i "" "s/operator\"\" _pt/operator\"\"_pt/g" "node_modules/react-native/ReactCommon/yoga/yoga/YGValue.h" 2>/dev/null || true
    sed -i "" "s/operator\"\" _percent/operator\"\"_percent/g" "node_modules/react-native/ReactCommon/yoga/yoga/YGValue.h" 2>/dev/null || true
fi
if [ -f "node_modules/react-native/scripts/react_native_pods_utils/script_phases.rb" ]; then
    sed -i '' "s/ERB.new(template, 0, '->')/ERB.new(template, trim_mode: '->')/g" "node_modules/react-native/scripts/react_native_pods_utils/script_phases.rb" 2>/dev/null || true
fi
if [ -f "node_modules/react-native/third-party-podspecs/boost.podspec" ]; then
    sed -i '' "s|https://boostorg.jfrog.io/artifactory/main/release/1.76.0/source/boost_1_76_0.tar.bz2|https://archives.boost.io/release/1.76.0/source/boost_1_76_0.tar.bz2|g" "node_modules/react-native/third-party-podspecs/boost.podspec" 2>/dev/null || true
fi

pod_install

jetify

echo "tools/postinstall finished with no errors!"
